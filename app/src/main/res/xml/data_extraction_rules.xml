<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup + device-transfer rules (Android 12+). Same intent as backup_rules.xml: back up app data
  (memorization, play history, settings) but NOT the downloaded audio (large, re-downloadable).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="audio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="audio/" />
    </device-transfer>
</data-extraction-rules>
