  "components": [
    {
      "name": "Play Pill",
      "kind": "button",
      "refersTo": "play-pill",
      "description": "The one obvious Play per ruku card; filled sage while playing.",
      "html": "<button class=\"ds-play\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"currentColor\"><path d=\"M8 5v14l11-7z\"/></svg>Play</button> <button class=\"ds-play is-playing\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"currentColor\"><path d=\"M6 19h4V5H6zm8-14v14h4V5z\"/></svg>Pause</button>",
      "css": ".ds-play{display:inline-flex;align-items:center;gap:.35rem;height:44px;padding:0 1.1rem 0 .85rem;border:0;border-radius:9999px;background:var(--md-primary-container,#dcebe5);color:var(--md-on-primary-container,#123b31);font:500 .9375rem Rubik,system-ui,sans-serif;cursor:pointer;transition:background 150ms cubic-bezier(.2,0,0,1)}.ds-play:hover{background:color-mix(in srgb,var(--md-on-primary-container,#123b31) 8%,var(--md-primary-container,#dcebe5))}.ds-play.is-playing{background:var(--md-primary,#33695a);color:var(--md-on-primary,#fff)}.ds-play:focus-visible{outline:2px solid var(--md-primary,#33695a);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Filled sage pill for dialog and settings actions.",
      "html": "<button class=\"ds-btn\">Download para</button>",
      "css": ".ds-btn{min-height:40px;padding:0 1.5rem;border:0;border-radius:9999px;background:var(--md-primary,#33695a);color:var(--md-on-primary,#fff);font:500 .875rem/1.25rem Rubik,system-ui,sans-serif;letter-spacing:.01em;cursor:pointer;transition:background 150ms,box-shadow 150ms}.ds-btn:hover{background:color-mix(in srgb,var(--md-on-primary,#fff) 8%,var(--md-primary,#33695a));box-shadow:0 1px 2px rgba(20,40,34,.05),0 1px 3px rgba(20,40,34,.05)}.ds-btn:focus-visible{outline:2px solid var(--md-primary,#33695a);outline-offset:2px}"
    },
    {
      "name": "Para Chip",
      "kind": "nav",
      "refersTo": "para-chip",
      "description": "Sideways row of para chips; current para filled sage.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-para on\"><span>1</span>Alif Lam Mim</button><button class=\"ds-para\"><span>2</span>Sayaqul</button></div>",
      "css": ".ds-chips{display:flex;gap:.5rem;padding:.5rem;background:var(--md-surface,#eef3f1)}.ds-para{display:inline-flex;align-items:center;gap:.5rem;min-height:44px;padding:0 .95rem 0 .35rem;border:0;border-radius:9999px;background:var(--md-card,#fff);color:var(--md-on-surface-variant,#5a6c67);font:400 .875rem Rubik,system-ui,sans-serif;cursor:pointer}.ds-para span{display:grid;place-items:center;min-width:32px;height:32px;border-radius:9999px;background:var(--md-surface,#eef3f1);color:var(--md-on-surface,#1a2925);font-weight:600}.ds-para:hover{background:var(--md-surface-container-low,#f5f8f7)}.ds-para.on{background:var(--md-primary,#33695a);color:var(--md-on-primary,#fff)}.ds-para.on span{background:color-mix(in srgb,#fff 22%,transparent);color:#fff}.ds-para:focus-visible{outline:2px solid var(--md-primary,#33695a);outline-offset:2px}"
    },
    {
      "name": "Status Chips",
      "kind": "chip",
      "refersTo": "status-memorized",
      "description": "Pastel ruku status: Heard, Memorized, Playing.",
      "html": "<span class=\"ds-st heard\">Heard</span> <span class=\"ds-st mem\">Memorized</span> <span class=\"ds-st play\">Playing</span>",
      "css": ".ds-st{display:inline-block;padding:0 .6rem;border-radius:9999px;font:500 .75rem/1.375rem Rubik,system-ui,sans-serif}.ds-st.heard{background:var(--md-surface-container-high,#e2eae7);color:var(--md-on-surface-variant,#5a6c67)}.ds-st.mem{background:var(--md-success-container,#d6efe3);color:var(--md-on-success-container,#0f3d29)}.ds-st.play{background:var(--calm-playing,#e7e3f6);color:var(--calm-on-playing,#4e4583)}"
    },
    {
      "name": "Ruku Card",
      "kind": "card",
      "refersTo": "ruku-card",
      "description": "White 20px card: title + status, surah line, action row. Playing adds a sage ring.",
      "html": "<div class=\"ds-card playing\"><div class=\"ds-t\">Ruku 1 <span class=\"ds-st2\">Playing</span></div><div class=\"ds-s\">Al-Baqarah · البقرة</div><button class=\"ds-pp\">Pause</button></div>",
      "css": ".ds-card{max-width:360px;padding:.85rem .5rem .6rem 1rem;border-radius:20px;background:var(--md-card,#fff);box-shadow:0 1px 2px rgba(20,40,34,.05),0 1px 3px rgba(20,40,34,.05);font-family:Rubik,system-ui,sans-serif;transition:box-shadow 150ms}.ds-card.playing{box-shadow:0 0 0 2px var(--md-primary-container,#dcebe5),0 2px 8px rgba(20,40,34,.07)}.ds-t{display:flex;gap:.5rem;align-items:center;font:600 1.0625rem/1.5rem Rubik,system-ui,sans-serif;color:var(--md-on-surface,#1a2925)}.ds-st2{padding:0 .6rem;border-radius:9999px;font:500 .75rem/1.375rem Rubik;background:var(--calm-playing,#e7e3f6);color:var(--calm-on-playing,#4e4583)}.ds-s{font-size:.875rem;line-height:1.5rem;color:var(--md-on-surface-variant,#5a6c67)}.ds-pp{margin:.5rem 0 .4rem;height:44px;padding:0 1.1rem;border:0;border-radius:9999px;background:var(--md-primary,#33695a);color:#fff;font:500 .9375rem Rubik}"
    },
    {
      "name": "Reciting Ayah",
      "kind": "custom",
      "refersTo": "ayah-reciting",
      "description": "Sage wash block and filled key pill on the ayah being recited.",
      "html": "<div class=\"ds-ayah\"><span class=\"ds-key\">▶ 2:3</span><p dir=\"rtl\">الَّذِينَ يُؤْمِنُونَ بِالْغَيْبِ</p></div>",
      "css": ".ds-ayah{padding:.35rem .6rem .4rem;border-radius:16px;background:var(--md-primary-container,#dcebe5)}.ds-ayah p{margin:.3rem 0;font:1.6rem/2 'IndoPak Nastaleeq','Traditional Arabic',serif;color:var(--md-on-surface,#1a2925)}.ds-key{display:inline-flex;align-items:center;height:32px;padding:0 .6rem;border-radius:9999px;background:var(--md-primary,#33695a);color:var(--md-on-primary,#fff);font:600 .8125rem Rubik,system-ui,sans-serif;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Settings Switch",
      "kind": "input",
      "refersTo": "settings-group",
      "description": "52x32 switch; handle grows and gains a check when on.",
      "html": "<label class=\"ds-sw\"><input type=\"checkbox\" checked><span></span>Word meanings</label>",
      "css": ".ds-sw{display:flex;align-items:center;gap:.75rem;font:500 .875rem Rubik,system-ui,sans-serif;color:var(--md-on-surface,#1a2925);cursor:pointer}.ds-sw input{position:absolute;opacity:0}.ds-sw span{position:relative;width:52px;height:32px;box-sizing:border-box;border-radius:9999px;border:2px solid var(--md-outline,#7d918b);background:var(--md-surface-container-highest,#d9e3e0);transition:background 150ms}.ds-sw span::after{content:'';position:absolute;top:50%;left:6px;width:16px;height:16px;margin-top:-8px;border-radius:50%;background:var(--md-outline,#7d918b);transition:all 150ms cubic-bezier(.05,.7,.1,1)}.ds-sw input:checked+span{background:var(--md-primary,#33695a);border-color:var(--md-primary,#33695a)}.ds-sw input:checked+span::after{width:24px;height:24px;margin-top:-12px;left:24px;background:var(--md-on-primary,#fff)}.ds-sw input:focus-visible+span{outline:2px solid var(--md-primary,#33695a);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Study Desk",
    "overview": "A calm, modern study app in the quran.com / Tarteel class. Misty sage ground, white rounded cards, one sage accent, soft pastel status chips. The mushaf and the teacher's voice lead; the interface stays quiet around them. No coloured header bands, no themed cultural ornament.\n\nPhone-first, one-handed, dense enough to show several rukus per screen. Light and dark are both first-class: every colour is a role token with a value per theme, never a hard-coded hex.",
    "keyCharacteristics": [
      "Tinted ground, white (light) or one-step-up (dark) cards.",
      "One accent: sage. Filled sage means \"current\" or \"playing\".",
      "Pills for every action and chip; 20px-radius cards.",
      "Near-flat; tone does the lifting, shadows are soft and low.",
      "Rubik for the UI, bundled; the mushaf keeps its own faces."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Sage is the only accent. Filled sage = current or playing; Sage Wash = available. Nothing else gets the accent.",
        "section": "colors"
      },
      {
        "name": "The Status Pastel Rule",
        "body": "Status is said by a soft chip, never by recolouring the card: Memorized green, Playing lilac, Heard and Paused neutral. Later state wins (Heard < Memorized < Playing/Paused).",
        "section": "colors"
      },
      {
        "name": "The Two Themes Rule",
        "body": "Any new colour ships as a role token with both a light and a dark value. player.html carries the same values.",
        "section": "colors"
      },
      {
        "name": "The Fixed Mushaf Rule",
        "body": "The mushaf faces (IndoPak Nastaleeq, Uthmani stack, Indo-Pak Naskh) are fixed. Never restyle, recolour or swap them; highlight with a wash behind the words, not colour on them.",
        "section": "typography"
      },
      {
        "name": "The Bundled Font Rule",
        "body": "Every UI face ships inside the app. No Google Fonts, no CDN.",
        "section": "typography"
      },
      {
        "name": "The 44px Rule",
        "body": "On coarse pointers every tappable control is at least 44x44px. Where the eye wants something smaller (32px ayah key pills), transparent borders outside the painted background carry the target to 44px.",
        "section": "layout"
      },
      {
        "name": "The Soft Lift Rule",
        "body": "No hard or offset shadows, no borders as depth. Lift is soft, low and tinted.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the `--md-*` role tokens for every colour, with light and dark values.",
      "Do make every touch control 44px on coarse pointers.",
      "Do put new surfaces on white/raised cards at 20px over the misty ground.",
      "Do say state with a pastel chip or a filled sage pill.",
      "Do ship any new UI face as a bundled woff2."
    ],
    "donts": [
      "Don't restyle, recolour or replace the mushaf faces.",
      "Don't load fonts from Google Fonts or any CDN.",
      "Don't add a coloured app bar, gold rules or themed ornament.",
      "Don't add a second accent colour; lilac is for \"Playing\" only.",
      "Don't use hard, offset or dark heavy shadows in light theme.",
      "Don't add small uppercase tracked labels above titles.",
      "Don't change the Settings word-switch rows' markup; restyle only via shared tokens/classes."
    ]
  }
}